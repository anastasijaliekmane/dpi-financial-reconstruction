{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/review", "destination": "/review/index.html" }
  ],
  "headers": [
    {
      "source": "/submission.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
